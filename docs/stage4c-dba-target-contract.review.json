  },
  "workflow": {
    "phases": [
      "PREPARE",
      "RECEIVE",
      "VERIFY",
      "COMMIT",
      "QC_APPROVE"
    ],
    "receiveRoles": [
      "ADMIN",
      "LAB_MANAGER",
      "TECHNICIAN"
    ],
    "verifyCommitQcCancelRoles": [
      "ADMIN",
      "LAB_MANAGER"
    ],
    "receiverCannotVerify": true,
    "physicalReturnAllowedConditions": [
      "GOOD",
