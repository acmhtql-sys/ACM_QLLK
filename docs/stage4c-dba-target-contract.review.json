    "minLength": 1,
    "maxLength": 128,
    "validation": "ASCII_ONLY_BEFORE_CASEFOLD",
    "key": "ASCII_UPPERCASE",
    "registry": "evidence_registry",
    "keyUniqueness": "GLOBAL_UNIQUE",
    "reuseAfterCancellation": false,
    "crossBorrowCollisionDenied": true,
    "crossEntityTypeCollisionDenied": true,
    "issuerAuthRequired": true,
    "existingCodeScanBeforeMigration": true
  },
  "custody": {
