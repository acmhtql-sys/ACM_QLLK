    ],
    "lostHandling": "SEPARATE_INCIDENT",
    "physicalCommitStockDestination": "QUARANTINE",
    "qcGoodReleaseAfterCommitOnly": true,
    "damagedNeverAutomaticallyAvailable": true
  },
  "requiredEntities": {
