    "cancelAfterPhysicalReceive": "RECONCILIATION_REQUIRED",
    "cancellationRequiresReason": true,
    "preserveReceiverAndCustody": true,
    "resolutionKinds": [
      "REVERSE_HANDOVER",
      "APPROVED_DISPOSITION"
