    "requireApprovedResolutionBeforeFinalCancelled": true,
    "requireImmutableEvidenceAndReviewer": true,
    "cancellationAvailableStockDelta": 0,
    "reconciliationReasonForPostReceiptCancel": "POST_RECEIPT_CANCEL",
