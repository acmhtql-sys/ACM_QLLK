# ==============================================================================
# ACM SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE (MONOREPO ROOT)
# ==============================================================================
# This template defines environment variables for both backend and frontend.
# Copy this file to .env at the root directory for standard local development.
# IMPORTANT: DO NOT COMMIT REAL PASSWORDS, TOKENS, OR SECRETS TO GIT.

# ------------------------------------------------------------------------------
# Backend Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 15+)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# Local Dev: postgresql://postgres:<your-db-password>@localhost:5432/acm_inventory?schema=public
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public"

# Authentication & Security
# IMPORTANT: In production/staging, generate a secure 32+ character random string.
# Example: openssl rand -base64 32
JWT_SECRET="<generate-random-secret-min-32-characters>"
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Deployment Profile & Cloud Safeguards (Optional in local_dev)
# Options: local_dev | cloud_staging
ACM_DEPLOYMENT_PROFILE=local_dev
STAGING_READ_ONLY=false
ALLOW_STAGING_AUTH_LOGIN=false

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
# Local: http://localhost:5000/api/v1 | Cloud: https://<your-backend>.onrender.com/api/v1
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_APP_TITLE="ACM – Components & Equipment Management System"
