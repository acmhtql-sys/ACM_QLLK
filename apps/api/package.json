{
  "name": "@acm/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.mock.config.ts tests/audit-logs.sanitization.unit.test.ts tests/auth.security.unit.test.ts tests/borrow.return.unit.test.ts tests/dashboard.reports.unit.test.ts tests/idempotency.unit.test.ts tests/items.inventory.unit.test.ts tests/kits.inventory.unit.test.ts tests/schema.integrity.unit.test.ts tests/users.admin.unit.test.ts tests/adjustment.zero-delta.unit.test.ts tests/borrow.return-operations.stage4c2a.unit.test.ts tests/borrow.return-operations.stage4c2b.schema-contract.unit.test.ts",
    "test:integration": "vitest run tests/e2e.phase8.complete.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "tsx scripts/migrateTestDb.ts",
    "prisma:seed:test": "tsx scripts/seedTestDb.ts",
    "test:uat:ledger": "vitest run tests/uat.phase11.ledger.integration.test.ts",
    "test:uat:gates": "vitest run tests/uat.phase11b.gates.integration.test.ts",
    "test:sql-contract:review": "vitest run -c vitest.mock.config.ts tests/borrow.return-operations.stage4c2b.sql-contract.review.test.ts"
  },
  "dependencies": {
    "@acm/shared": "*",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.8.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
