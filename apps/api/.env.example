# ==============================================================================
# ACM API BACKEND ENVIRONMENT TEMPLATE (@acm/api)
# ==============================================================================
# Copy this file to .env in your root directory or apps/api/.env for local development.
# NEVER commit .env files containing real credentials to version control.

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Cross-Origin Resource Sharing (CORS)
# Local: http://localhost:5173 | Cloud: https://<your-frontend-domain>.vercel.app
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 15+)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# Local Dev Example: postgresql://postgres:<your-db-password>@localhost:5432/acm_inventory?schema=public
# Supabase Pooler Example: postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?schema=public
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public"

# Authentication & Security
# WARNING: In production/staging, JWT_SECRET must be at least 32 characters of high-entropy randomness.
# Linux/Mac generation: openssl rand -base64 32
# PowerShell generation: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET="<generate-random-secret-min-32-characters>"
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

# Deployment Profile (Optional for local_dev, mandatory in production/cloud_staging)
# Options: local_dev | cloud_staging
ACM_DEPLOYMENT_PROFILE=local_dev

# Cloud Staging Safeguards (Used when ACM_DEPLOYMENT_PROFILE=cloud_staging)
STAGING_READ_ONLY=false
ALLOW_STAGING_AUTH_LOGIN=false
